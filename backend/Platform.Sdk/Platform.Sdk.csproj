<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The platform's contracts, with the platform's namespaces. Application code compiles against
    this here and against the platform itself after integration, without changes.
    Do not add behaviour here: the platform provides the real implementations.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Primworth_API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

</Project>
